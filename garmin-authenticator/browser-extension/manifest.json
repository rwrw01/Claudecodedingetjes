{
  "manifest_version": 3,
  "name": "Garmin Authenticator",
  "version": "1.0.0",
  "description": "Stuurt Microsoft Authenticator number matching naar je Garmin horloge",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://login.microsoft.com/*",
    "https://login.live.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://login.microsoftonline.com/*",
        "https://login.microsoft.com/*",
        "https://login.live.com/*"
      ],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
